//24 bits instruction for picoMIPS
//6b opcode, 5b %d, 5b %s, 8b address/immediate
//6 hexadecimal digits, 24 binary, assembler

////////////////////////////////////////////////////
//X Rd, address	        Rd ? DataMemory[address]
//H Rd, address	        Rd ? DataMemory[address]
//MUL Rd, Rs, Rt	Rd ? Rs × Rt
//ADD Rd, Rs, Rt	Rd ? Rs + Rt
//Y Rs, address	        DataMemory[address] ? Rs
////////////////////////////////////////////////////

///HEX///////////////////////BINARY/////////////////////ASSEMBLER/////////////////
//        opcode  %d  %s  %t  address/imm/unused
002000 //24'b0000_00 00_001 0_0000_ 0000_0000 X R1, 0   // R1 = Data_M[0] = x0
044004 //24'b0000_01 00_010 0_0000_ 0000_0100 H R2, 4   // R2 = Data_M[4] = h0
106110 //24'b0001_00 00_011 0_0001_ 0001_0 000 MUL R3, R1, R2    // R3 = x0 * h0
002001 //24'b0000_00 00_001 0_0000_ 0000_0001 X R1, 1
044005 //24'b0000_01 00_010 0_0000_ 0000_0101 H R2, 5
108110 //24'b0001_00 00_100 0_0001_ 0001_0 000 MUL R4, R1, R2
086320 //24'b0000_10 00_011 0_0011_ 0010_0 000 ADD R3, R3, R4
002002 //24'b0000_00 00_001 0_0000_ 0000_0010 X R1, 2
044006 //24'b0000_01 00_010 0_0000_ 0000_0110 H R2, 6
108110 //24'b0001_00 00_100 0_0001_ 0001_0 000 MUL R4, R1, R2
086320 //24'b0000_10 00_011 0_0011_ 0010_0 000 ADD R3, R3, R4
002003 //24'b0000_00 00_001 0_0000_ 0000_0011 X R1, 3
044007 //24'b0000_01 00_010 0_0000_ 0000_0111 H R2, 7
108110 //24'b0001_00 00_100 0_0001_ 0001_0 000 MUL R4, R1, R2
086320 //24'b0000_10 00_011 0_0011_ 0010_0 000 ADD R3, R3, R4
306308 //24'b0011_00 00_011 0_0011_ 0000_1000 Y, R3, 8
